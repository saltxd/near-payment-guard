{
  "name": "near-payment-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain signer and shared test vectors for the NEAR agent payment guard",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test ts/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:contract": "node scripts/build-contracts.mjs",
    "pretest:sandbox": "npm run build:contract && node scripts/ensure-sandbox.mjs",
    "test:sandbox": "node --test ts/sandbox/*.test.ts",
    "predemo": "npm run build:contract && node scripts/ensure-sandbox.mjs",
    "demo": "node ts/sandbox/demo.ts",
    "vectors:generate": "node ts/scripts/generate-vectors.ts",
    "vectors:check": "node ts/scripts/generate-vectors.ts --check"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "binaryen": "123.0.0",
    "near-api-js": "5.1.1",
    "near-workspaces": "5.0.0",
    "typescript": "5.9.2"
  }
}
